# Copy this file to .env and fill in real values. Never commit .env itself.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=campus_placement_portal

# Email settings — set EMAIL_ENABLED=false to skip real sending and just
# print OTPs to the console (good for local dev without SMTP setup).
# Set EMAIL_ENABLED=true (with real SMTP credentials below) to send actual
# emails — no code changes needed to switch between the two.
# Example for Gmail: create an "App Password" (not your normal password)
# at https://myaccount.google.com/apppasswords
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=your_email@gmail.com
SMTP_TLS=true

# Used to build links inside emails (e.g. the admin invitation's
# "Set Password" link). Change this in production to your real domain.
FRONTEND_BASE_URL=http://localhost:5173

# JWT settings — SECRET_KEY must be a long, random string. Generate one with:
# python -c "import secrets; print(secrets.token_hex(32))"
# Never reuse this value across projects or commit a real one to git.
SECRET_KEY=replace_this_with_a_generated_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
